---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  noindex?: boolean;
  // A post's slug picks its own preview image; every other page uses the site's.
  ogSlug?: string;
  // Right side of the menu bar (or the "bar" slot), and the scrolling line under it.
  right?: string;
  marquee?: boolean;
  // Human pages: black, dim words, nothing else. No tabs, buttons or windows.
  human?: boolean;
}

const { title, description, type = 'website', publishedDate, noindex = false, ogSlug, right, marquee = false, human = false } = Astro.props;

// Human has no tab: the home page's locked row is the only way in.
const tabs = [
  ['Home', '/'], ['About', '/about/'], ['Links', '/tree/'], ['Uses', '/uses/'], ['Guestbook', '/guestbook/'],
  ['PGP', '/pgp/'], ['Tests', '/test/'], ['Colophon', '/colophon/'], ['Misc', '/misc/'],
];
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pageTitle = title ? `${title} · #V0ID` : '#V0ID · Fahad Al-Ghamdi';
const metaDescription = description || 'Technical blog by Fahad Al-Ghamdi (#V0ID): backend engineering, Rust, TypeScript, Cloudflare, and systems programming.';
const canonicalURL = new URL(Astro.url.pathname, 'https://www.v0id.me');
// Drawn on request with the status at that moment (src/pages/og.png.ts, og/[slug].png.ts).
const ogImage = ogSlug ? `https://www.v0id.me/og/${ogSlug}.png` : 'https://www.v0id.me/og.png';

const person = {
  '@type': 'Person',
  name: 'Fahad Al-Ghamdi',
  alternateName: '#V0ID',
  url: 'https://www.v0id.me/about/',
  sameAs: ['https://github.com/v0id-user', 'https://x.com/fhad_________', 'https://linkedin.com/in/v0id-user'],
};
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: metaDescription,
      datePublished: publishedDate,
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      image: ogImage,
      author: person,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '#V0ID',
      url: 'https://www.v0id.me/',
      author: person,
    };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="#V0ID" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="#V0ID" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:site" content="@fhad_________" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="alternate" type="application/rss+xml" title="#V0ID" href="/rss.xml" />
  </head>
  <body>
    {human ? (
      <div class="void">
        <nav class="void-top" aria-label="Way out">
          <a href="/" aria-label="Home">†</a>
          <slot name="bar" />
        </nav>
        <slot />
      </div>
    ) : (
    <div class="desk">
      <nav class="bar" aria-label="Menu bar">
        <a href="/">#V0ID</a>
        {right && <span class="bar-right">{right}</span>}
      </nav>
      {marquee && <marquee class="marquee" scrollamount="3">no javascript was sent to you ··· this status is gpg signed ··· sign the guestbook ··· curl -L v0id.me ···</marquee>}
      <div class="wrap">
        <nav class="tabs" aria-label="Sections">
          {tabs.map(([label, href]) => (
            <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <slot />
        <footer class="buttons">
          <a class="w" href="/">#V0ID</a>
          <a href="/colophon/">NO JS</a>
          <a href="/pgp/">GPG SIGNED</a>
          <a href="/rss.xml">RSS</a>
          <a href="/misc/">CURL ME</a>
          <a href="/guestbook/">SIGN ME</a>
        </footer>
      </div>
    </div>
    )}
  </body>
</html>
