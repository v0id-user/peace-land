---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  noindex?: boolean;
  // A post's slug picks its own preview image; every other page uses the site's.
  ogSlug?: string;
}

const { title, description, type = 'website', publishedDate, noindex = false, ogSlug } = Astro.props;
const pageTitle = title ? `${title} · #V0ID` : '#V0ID · Fahad Al-Ghamdi';
const metaDescription = description || 'Technical blog by Fahad Al-Ghamdi (#V0ID): backend engineering, Rust, TypeScript, Cloudflare, and systems programming.';
const canonicalURL = new URL(Astro.url.pathname, 'https://www.v0id.me');
// Drawn on request with the status at that moment (src/pages/og.png.ts, og/[slug].png.ts).
const ogImage = ogSlug ? `https://www.v0id.me/og/${ogSlug}.png` : 'https://www.v0id.me/og.png';

const person = {
  '@type': 'Person',
  name: 'Fahad Al-Ghamdi',
  alternateName: '#V0ID',
  url: 'https://www.v0id.me/about/',
  sameAs: ['https://github.com/v0id-user', 'https://x.com/fhad_________', 'https://linkedin.com/in/v0id-user'],
};
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: metaDescription,
      datePublished: publishedDate,
      url: canonicalURL.href,
      mainEntityOfPage: canonicalURL.href,
      image: ogImage,
      author: person,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '#V0ID',
      url: 'https://www.v0id.me/',
      author: person,
    };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="#V0ID" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="#V0ID" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:site" content="@fhad_________" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="alternate" type="application/rss+xml" title="#V0ID" href="/rss.xml" />
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <div class="brand-row">
          <a href="https://github.com/v0id-user" target="_blank" rel="noopener" aria-label="GitHub profile"><img src="/avatar" alt="GitHub avatar" width="24" height="24" class="avatar" /></a>
          <a href="/" class="brand">#V0ID</a>
        </div>
        <iframe
          src="/now-playing"
          class="np-frame"
          title="Now playing on Spotify"
        ></iframe>
        <nav>
          {posts.map((post) => (
            <a
              href={`/posts/${post.data.slug}/`}
              class={Astro.url.pathname.includes(post.data.slug) ? 'active' : ''}
            >
              {post.data.title}
            </a>
          ))}
          <a href="/about/" class={Astro.url.pathname.startsWith('/about') ? 'active' : ''} style="margin-top: 6px;">about</a>
          <a href="/tree/" class={Astro.url.pathname.startsWith('/tree') ? 'active' : ''}>tree</a>
          <a href="/pgp/" class={Astro.url.pathname.startsWith('/pgp') ? 'active' : ''}>pgp</a>
          <a href="/human/" class={Astro.url.pathname.startsWith('/human') ? 'active' : ''} style="margin-top: 6px;">human</a>
          <a href="/test/" class={Astro.url.pathname.startsWith('/test') ? 'active' : ''} style="margin-top: 16px;">tests</a>
          <a href="/misc/" class={Astro.url.pathname.startsWith('/misc') ? 'active' : ''}>misc</a>
        </nav>
      </aside>

      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>
