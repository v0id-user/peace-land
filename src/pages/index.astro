---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { env } from 'cloudflare:workers';
import { getVisits } from '../lib/visits';

// Rendered per request for the visit count and for terminals (src/middleware.ts).
export const prerender = false;
const visits = await getVisits((env as any).SESSION);

const posts = (await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base>
  <h1 class="visually-hidden">#V0ID, a technical blog by Fahad Al-Ghamdi</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.data.slug}/`}>
          <span class="post-title">{post.data.title}</span>
          <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="rss-link"><a href="/rss.xml">rss</a>{visits !== null && <span class="visits"> · {visits.toLocaleString('en-US')} visits</span>}</p>
</Base>
