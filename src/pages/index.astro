---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import NowSpinning from '../components/NowSpinning.astro';
import MacStatus from '../components/MacStatus.astro';
import { env } from 'cloudflare:workers';
import { getVisits } from '../lib/visits';
import { publishedPosts } from '../lib/posts';
import { getPresence } from '../lib/presence';
import { getLatestPublicCommit } from '../lib/github';
import { getNowPlaying } from '../lib/spotify';
import { statusWord } from '../lib/status';
import { APPROVED, listEntries } from '../lib/guestbook';

// Rendered per request for the visit count, music, status and for terminals (src/middleware.ts).
export const prerender = false;

const mergedEnv: any = { ...import.meta.env, ...env };
const [visits, posts, presence, git, np, signed] = await Promise.all([
  getVisits(mergedEnv.SESSION),
  publishedPosts(),
  getPresence(mergedEnv.SESSION),
  getLatestPublicCommit(mergedEnv, (p) => Astro.locals.cfContext?.waitUntil(p)),
  getNowPlaying(mergedEnv).catch(() => null),
  mergedEnv.SESSION ? listEntries(mergedEnv.SESSION, APPROVED).catch(() => []) : Promise.resolve([]),
]);

const word = statusWord(presence);
if (word) Astro.response.headers.set('x-fahad', word);

const LOGO = String.raw`   _  _   __     _____ ___ ____
 _| || |_ \ \   / / _ \_ _|  _ \
|_  ..  _| \ \ / / | | | || | | |
|_      _|  \ V /| |_| | || |_| |
  |_||_|     \_/  \___/___|____/`;

const num = (n: number) => String(n).padStart(2, '0');
const size = (body: string | undefined) => `${Math.max(1, Math.round((body?.length ?? 0) / 1024))}K`;
const souls = visits === null ? null : String(visits).padStart(6, '0');
---

<Base marquee right={visits === null ? undefined : `you are soul no. ${visits.toLocaleString('en-US')}`}>
  <h1 class="visually-hidden">#V0ID, a technical blog by Fahad Al-Ghamdi</h1>
  <div class="cols">
    <aside class="side">
      <Win title="Terminal: node 1">
        <div class="win-body mono term">
          <pre class="logo" aria-label="#V0ID">{LOGO}</pre>
          <p>{visits !== null && <>CALLER #{visits.toLocaleString('en-US')}<br /></>}SYSOP: FAHAD AL-GHAMDI</p>
        </div>
      </Win>
      <NowSpinning np={np} />
      <MacStatus presence={presence} commit={git.commit} />
    </aside>

    <Win title="The Writings" as="main" class="main" meta={[`${posts.length} items`, '† on v0id.me']}>
      <ol class="win-body writings">
        {posts.map((post, i) => (
          <li>
            <span class="n">{num(i + 1)}</span>
            <a class="t" href={`/posts/${post.data.slug}/`}>{post.data.title}</a>
            <span class="s">{size(post.body)}</span>
          </li>
        ))}
        <li class="locked">
          <span class="n">{num(posts.length + 1)}</span>
          <a class="t" href="/human/" aria-label="Locked">████████ ███ ██████████████</a>
          <span class="s">[locked]</span>
        </li>
      </ol>
    </Win>

    <aside class="side side-r">
      <Win title="About This Fahad">
        <p class="win-body">Backend engineer at <a href="http://www.thmanyah.com/" target="_blank" rel="noopener">Thmanyah</a>. TypeScript day to day. Go at work. Rust when it matters.</p>
      </Win>
      <Win title="The Book">
        <p class="win-body">
          {signed.length === 0 ? 'Empty. Nobody has signed.' : `${signed.length} ${signed.length === 1 ? 'soul has' : 'souls have'} signed.`}<br />
          <a href="/guestbook/">Leave your name</a>
        </p>
      </Win>
      {souls && (
        <Win title="Souls">
          <div class="win-body digits" role="img" aria-label={`${visits!.toLocaleString('en-US')} visits`}>
            {[...souls].map((d) => <span>{d}</span>)}
          </div>
        </Win>
      )}
    </aside>
  </div>
</Base>
