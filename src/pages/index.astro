---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import Logo from '../components/Logo.astro';
import Live from '../components/Live.astro';
import { env } from 'cloudflare:workers';
import { getVisits } from '../lib/visits';
import { publishedPosts, readMinutes } from '../lib/posts';
import { APPROVED, listEntries } from '../lib/guestbook';

// Rendered per request for the visit count, the guestbook count and for terminals
// (src/middleware.ts). Music and status come from the live frame.
export const prerender = false;

const kv = (env as any).SESSION as KVNamespace | undefined;
const [visits, posts, signed] = await Promise.all([
  getVisits(kv),
  publishedPosts(),
  kv ? listEntries(kv, APPROVED).catch(() => []) : Promise.resolve([]),
]);

const num = (n: number) => String(n).padStart(2, '0');
const souls = visits === null ? null : String(visits).padStart(6, '0');
---

<Base marquee right={visits === null ? undefined : `you are soul no. ${visits.toLocaleString('en-US')}`}>
  <h1 class="visually-hidden">#V0ID, a technical blog by Fahad Al-Ghamdi</h1>
  <div class="cols">
    <aside class="side">
      <Logo visits={visits} />
      <Live />
    </aside>

    <Win title="The Writings" as="main" class="main" meta={[`${posts.length} items`, '† on v0id.me']}>
      <ol class="win-body writings">
        {posts.map((post, i) => (
          <li>
            <span class="n">{num(i + 1)}</span>
            <a class="t" href={`/posts/${post.data.slug}/`}>{post.data.title}</a>
            <span class="s">{readMinutes(post.body)} min</span>
          </li>
        ))}
        <li class="locked">
          <span class="n">{num(posts.length + 1)}</span>
          <a class="t" href="/human/" aria-label="Locked">████████ ███ ██████████████</a>
          <span class="s">[locked]</span>
        </li>
      </ol>
    </Win>

    <aside class="side side-r">
      <Win title="The Book">
        <p class="win-body">
          {signed.length === 0 ? 'Empty. Nobody has signed.' : `${signed.length} ${signed.length === 1 ? 'soul has' : 'souls have'} signed.`}<br />
          <a href="/guestbook/">Leave your name</a>
        </p>
      </Win>
      {souls && (
        <Win title="Souls">
          <div class="win-body digits" role="img" aria-label={`${visits!.toLocaleString('en-US')} visits`}>
            {[...souls].map((d) => <span>{d}</span>)}
          </div>
        </Win>
      )}
    </aside>
  </div>
</Base>
