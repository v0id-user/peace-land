---
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import { render } from 'astro:content';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const link = (p?: (typeof posts)[number]) => p && { title: p.data.title, href: `/posts/${p.data.slug}/` };
  return posts.map((post, i) => ({
    params: { slug: post.data.slug },
    props: { post, newer: link(posts[i - 1]), older: link(posts[i + 1]) },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article" publishedDate={post.data.date.toISOString()} ogSlug={post.data.slug}>
  <Article slug={post.data.slug} title={post.data.title} date={post.data.date} body={post.body} back={{ title: 'The Writings', href: '/' }} newer={newer} older={older}>
    <Content />
  </Article>
</Base>
