---
export const prerender = false;
import '../styles/global.css';
import NowSpinning from '../components/NowSpinning.astro';
import MacStatus from '../components/MacStatus.astro';
import { getNowPlaying } from '../lib/spotify';
import { getLatestPublicCommit } from '../lib/github';
import { getPresence } from '../lib/presence';
import { statusWord } from '../lib/status';
import { env as cfEnv } from 'cloudflare:workers';

// Now Spinning and Fahad's Mac, framed into every page by src/components/Live.astro.
// It reloads itself every 15 seconds, so the status stays current with no client JS.
const mergedEnv: any = { ...import.meta.env, ...cfEnv };
const [np, git, presence] = await Promise.all([
  getNowPlaying(mergedEnv).catch(() => null),
  getLatestPublicCommit(mergedEnv, (p) => Astro.locals.cfContext?.waitUntil(p)),
  getPresence(mergedEnv.SESSION),
]);
// Shows in production whether the git row came from a fresh, stale or missing stored answer.
Astro.response.headers.set('x-git-cache', git.cache);
const word = statusWord(presence);
if (word) Astro.response.headers.set('x-fahad', word);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="15" />
    <meta name="robots" content="noindex" />
    <title>Now spinning</title>
  </head>
  <body class="frame">
    <NowSpinning np={np} />
    <MacStatus presence={presence} commit={git.commit} />
  </body>
</html>
