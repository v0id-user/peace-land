---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import Pixel from '../components/Pixel.astro';

const links = [
  { name: 'GitHub', url: 'https://github.com/v0id-user' },
  { name: 'X', url: 'https://x.com/fhad_________' },
  { name: 'LinkedIn', url: 'https://linkedin.com/in/v0id-user' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/v0id.me', inactive: true },
  { name: 'Reddit', url: 'https://reddit.com/u/v0id_user' },
  { name: 'Instagram', url: 'https://instagram.com/v0id_user', inactive: true },
  { name: 'Email', url: 'mailto:hey@v0id.me' },
  { name: 'PGP key', url: 'https://pgp.v0id.me' },
  { name: 'Book a Call', url: 'https://cal.com/v0id-user/30min' },
];
const archived = links.filter((l) => l.inactive).length;
---

<Base title="Tree" description="Links and social profiles for #V0ID: GitHub, X, LinkedIn, email, and more.">
  <Win title="Links" as="main" class="w-md" meta={[`${links.length} aliases`, `${archived} archived`]}>
    <h1 class="visually-hidden">Links</h1>
    <ul class="win-body icons">
      {links.map((link) => (
        <li>
          <a class:list={['ico', 'alias', { archived: link.inactive }]} href={link.url} target="_blank" rel="noopener">
            <Pixel name="doc" size={32} />
            <span>{link.name}{link.inactive && <><br />(archived)</>}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="win-foot">Mostly inactive on socials. Email has the highest chance of a response. LinkedIn and Reddit work too.</p>
  </Win>
</Base>
