---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import Pixel from '../components/Pixel.astro';
import { PGP_PUBLIC_KEY_ARMORED } from '../lib/pgpKey';
---

<Base title="PGP" description="OpenPGP public key for #V0ID (hey@v0id.me) for signing and encryption.">
  <Win title="Key Chain" as="main" class="w-lg">
    <div class="win-body info">
      <div class="info-head">
        <Pixel name="key" size={24} />
        <div><h1>#V0ID &lt;hey@v0id.me&gt;</h1><span class="dim">OpenPGP key for signing and encryption</span></div>
      </div>
      <p class="label">Fingerprint</p>
      <p class="mono fingerprint"><span>6BEC 93C9 0963</span> <span>3B56 534E 2DCE</span> <span>1F4F 0EDA 6461 9E19</span></p>
      <p class="label">Get it</p>
      <p class="mono">$ gpg --fetch-keys https://pgp.v0id.me</p>
      <p class="small">Raw: <a href="https://pgp.v0id.me">pgp.v0id.me</a> · <a href="https://gpg.v0id.me">gpg.v0id.me</a></p>
      <pre class="mono keyblock">{PGP_PUBLIC_KEY_ARMORED}</pre>
    </div>
  </Win>
</Base>
