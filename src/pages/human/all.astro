---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { getHumanEntries } from '../../lib/human';
import { env as cfEnv } from 'cloudflare:workers';

const entries = await getHumanEntries({ ...import.meta.env, ...cfEnv });
---

<Base title="Human">
  <div class="tree-page">
    <h1>Human</h1>
    <ul class="tree-links">
      {entries.map((entry) => (
        <li><a href={`/human/${entry.slug}`}>{entry.title}</a></li>
      ))}
    </ul>
  </div>
</Base>
