---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { getHumanEntry, renderHumanMarkdown } from '../../lib/human';
import { env as cfEnv } from 'cloudflare:workers';

const { slug } = Astro.params;
const entry = await getHumanEntry(slug!, { ...import.meta.env, ...cfEnv });
if (!entry) {
  return new Response('Not found', { status: 404 });
}
const html = renderHumanMarkdown(entry.body);
---

<Base title={entry.title} type="article" noindex={true} human>
  <a slot="bar" href="/human/all">back</a>
  <article class="void-piece">
    <h1>{entry.title}</h1>
    <div set:html={html} />
  </article>
</Base>
