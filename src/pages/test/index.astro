---
import Base from '../../layouts/Base.astro';
import Win from '../../components/Win.astro';
import Pixel from '../../components/Pixel.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('test')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Test" noindex={true}>
  <Win title="Tests" as="main" class="w-sm" meta={[`${entries.length} items`, 'pages that check the renderer']}>
    <h1 class="visually-hidden">Tests</h1>
    <ul class="win-body icons">
      {entries.map((entry) => (
        <li>
          <a class="ico" href={`/test/${entry.data.slug}/`}>
            <Pixel name="doc" size={32} />
            <span>{entry.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </Win>
</Base>
